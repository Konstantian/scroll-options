#include <winver.h>

1 ICON "scroll-options.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_NUM
PRODUCTVERSION VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Scroll Options"
            VALUE "FileVersion", VERSION
            VALUE "InternalName", "scroll-options"
            VALUE "OriginalFilename", "scroll-options.exe"
            VALUE "ProductName", "scroll-options"
            VALUE "ProductVersion", VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
